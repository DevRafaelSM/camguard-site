---
// Ícone de câmera do header. Substituição total da versão anterior (que era
// a peça de demonstração em 720px reduzida via % para ~40-48px) por um
// design novo do usuário, já calibrado e simplificado especificamente para
// ~50px de ícone (menos camadas decorativas, lente maior, piscada mais
// gráfica, reflexo proporcionalmente maior) — ver
// camera_css_camguard_mini_50px_simplificada_v8.html.
//
// DECISÃO TÉCNICA (reportada, não decidida em silêncio): este design usa
// posicionamento em px fixos (não % / var(--s) fluido como a versão
// anterior), calibrado pro canvas de exatamente 50px — os próprios
// comentários do arquivo do usuário dizem "legível em ~50px" e "branco
// propositalmente grande pra funcionar em 50px". Optei por (a): fixar
// .scene em 50x50px, sem clamp() fluido, em vez de (b) um wrapper com
// transform:scale() dinâmico. Escalar por scale() reintroduziria o mesmo
// problema que a v6 tinha (fator de escala pequeno = detalhes ilegíveis),
// exatamente o que essa recalibração do usuário existe pra evitar — manter
// os px fixos como o usuário desenhou é o ponto central da entrega.
// Verificado: no piso de 300px de viewport (mínimo do projeto), o header já
// vira hambúrguer abaixo de 768px, então a linha é só ícone (50px) + botão
// hambúrguer (32px) + padding do container (mín. 16px cada lado) + gap: ~
// 138px de ~300px (46%), sem overflow horizontal. Altura do header sobe
// ~11px no piso mínimo (39px→50px de ícone), aceitável.
//
// Camadas que o próprio arquivo do usuário desativa via display:none
// (.grid, .mount-side, e os pseudo-elementos ::before/::after sem conteúdo
// visual: mount-top::after, camera-top::after, camera-bottom::before/
// ::after, lens-dark::before, iris::after) foram omitidas aqui por
// completo, não copiadas como regras mortas.
//
// Paleta de cores é intencionalmente própria desta peça (não usa os tokens
// de tema do site) — mantida como está, só as custom properties realmente
// usadas (--night/--coral/--iris/--iris-light/--white) foram trazidas; o
// resto da paleta do :root original não era referenciada em nenhuma regra.
---

<a class="brand" href="/" aria-label="CamGuard Hub, página inicial">
  <div class="scene" aria-hidden="true">
    <div class="mount-top"></div>
    <div class="mount-vertical"></div>

    <div class="camera-shell">
      <div class="camera-top"></div>

      <div class="camera-bottom">
        <div class="lens-dark">
          <div class="iris" id="camera-iris">
            <div class="highlight" id="camera-highlight"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</a>

<style>
  .scene {
    --s: 50px;

    /* Paleta específica desta peça, só as cores realmente referenciadas abaixo. */
    --night: #070a1d;
    --coral: #ff684b;
    --iris: #4d7ee8;
    --iris-light: #79a7ff;
    --white: #fffdf4;

    position: relative;
    width: var(--s);
    height: var(--s);
    overflow: visible;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    flex: none;
  }

  /* Suporte esquerdo */

  .mount-top {
    position: absolute;
    z-index: 1;
    left: 6px;
    top: 7px;
    width: 30px;
    height: 9px;
    border-radius: 3px;

    background: linear-gradient(90deg, #5c2c46 0%, #392148 35%, #21183f 100%);

    box-shadow: inset 1px 0 0 rgba(255, 104, 75, 0.82);
  }

  .mount-top::before {
    content: "";
    position: absolute;
    left: 7px;
    bottom: -1px;
    width: 12px;
    height: 6px;
    background: var(--night);
    border-radius: 0 0 0 8px;
  }

  .mount-vertical {
    position: absolute;
    z-index: 1;
    left: 3px;
    top: 5px;
    width: 6px;
    height: 33px;
    border-radius: 3px;

    background: linear-gradient(90deg, #673043 0%, #2a1b42 65%, #18142f 100%);

    box-shadow: inset 1px 0 0 rgba(255, 105, 74, 0.8);
  }

  /* Corpo */

  .camera-shell {
    position: absolute;
    z-index: 4;
    left: 15px;
    top: 11px;
    width: 33px;
    height: 35px;

    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.34));
  }

  .camera-top {
    position: absolute;
    left: 0;
    top: 0;
    width: 33px;
    height: 19px;
    overflow: hidden;

    border-radius: 15px 15px 4px 4px;

    background: linear-gradient(115deg, #2b204a 0%, #42234a 58%, #8d3b45 100%);

    box-shadow:
      inset -1px 0 0 var(--coral),
      inset 1px 0 0 rgba(255, 131, 91, 0.35);
  }

  .camera-top::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgba(255, 130, 92, 0.3);
  }

  .camera-bottom {
    position: absolute;
    left: 4px;
    top: 16px;
    width: 25px;
    height: 18px;
    overflow: hidden;

    border-radius: 0 0 12px 12px;

    background: linear-gradient(145deg, #1b1736 0%, #0d1028 65%, #251734 100%);

    box-shadow:
      inset 1px 0 0 rgba(255, 110, 77, 0.48),
      inset -1px 0 0 rgba(255, 104, 75, 0.68);
  }

  /* Lente, o foco principal do design */

  .lens-dark {
    position: absolute;
    z-index: 2;
    left: 4px;
    top: 1px;
    width: 17px;
    height: 17px;
    border-radius: 50%;

    display: grid;
    place-items: center;

    background: radial-gradient(circle at 42% 38%, #171b43 0%, #090d23 58%, #030511 100%);

    box-shadow: 0 0 0 1px rgba(92, 61, 150, 0.42);
  }

  /* Maior e mais claro de propósito, pra funcionar em ~50px. */
  .iris {
    position: relative;
    width: 10px;
    height: 10px;
    overflow: hidden;
    border-radius: 50%;

    transform-origin: 50% 50%;
    will-change: transform;

    background: radial-gradient(
      circle at 35% 30%,
      var(--iris-light) 0%,
      #6090ef 30%,
      var(--iris) 65%,
      #24439b 100%
    );

    box-shadow: 0 0 2px rgba(87, 126, 245, 0.7);
  }

  /*
    Branco propositalmente grande: em ~50px precisa ser claramente visível
    em movimento. Único elemento que acompanha o cursor (ver script),
    matematicamente preso dentro do círculo azul.
  */
  .highlight {
    --x: 0px;
    --y: 0px;

    position: absolute;
    left: 3px;
    top: 3px;
    width: 4px;
    height: 4px;
    border-radius: 50%;

    background: var(--white);

    box-shadow:
      0 0 1px #fff,
      0 0 2px rgba(255, 190, 130, 0.78);

    transform: translate3d(var(--x), var(--y), 0);
    will-change: transform;
  }

  /* Piscada mais "gráfica" (fecha o azul quase totalmente): mais legível num ícone minúsculo. */
  .iris.blink {
    animation: blink-eye 300ms cubic-bezier(0.55, 0.02, 0.35, 1);
  }

  @keyframes blink-eye {
    0% {
      transform: scaleY(1);
    }
    34% {
      transform: scaleY(0.12);
    }
    47% {
      transform: scaleY(0.02);
    }
    58% {
      transform: scaleY(0.07);
    }
    100% {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iris.blink {
      animation: none;
    }
    .highlight {
      transform: none !important;
    }
  }
</style>

<script>
  // Reflexo (.highlight) segue o cursor com inércia (lerp), só quando há
  // mouse real (hover:hover + pointer:fine) — em touch, sem fallback via
  // pointerdown, o reflexo fica centrado e estático (default do CSS acima).
  // Piscada roda sempre (independe de haver cursor), respeitando
  // prefers-reduced-motion.
  (function () {
    const iris = document.getElementById("camera-iris");
    const highlight = document.getElementById("camera-highlight");
    if (!iris || !highlight) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const canTrack = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;

    function updateTarget(clientX, clientY) {
      if (reduceMotion.matches) return;

      const irisRect = iris.getBoundingClientRect();
      const dotRect = highlight.getBoundingClientRect();

      const cx = irisRect.left + irisRect.width / 2;
      const cy = irisRect.top + irisRect.height / 2;

      const dx = clientX - cx;
      const dy = clientY - cy;
      const distance = Math.hypot(dx, dy);

      const irisRadius = irisRect.width / 2;
      const dotRadius = dotRect.width / 2;
      const margin = irisRect.width * 0.005;
      const maxTravel = Math.max(0, irisRadius - dotRadius - margin);

      const reactionDistance = Math.max(window.innerWidth, window.innerHeight) * 0.1;
      const strength = Math.min(distance / reactionDistance, 1);

      if (distance < 0.001) {
        targetX = 0;
        targetY = 0;
        return;
      }

      targetX = (dx / distance) * maxTravel * strength;
      targetY = (dy / distance) * maxTravel * strength;
    }

    function animate() {
      // Sem isto o loop rodaria pra sempre mesmo parado visualmente
      // (transform:none!important via CSS) com reduced-motion ativo. Ao
      // simplesmente não reagendar o próximo frame, o loop encerra sozinho.
      if (reduceMotion.matches) return;

      currentX += (targetX - currentX) * 0.3;
      currentY += (targetY - currentY) * 0.3;

      highlight.style.setProperty("--x", `${currentX.toFixed(3)}px`);
      highlight.style.setProperty("--y", `${currentY.toFixed(3)}px`);

      requestAnimationFrame(animate);
    }

    if (canTrack) {
      window.addEventListener(
        "pointermove",
        (e) => updateTarget(e.clientX, e.clientY),
        { passive: true },
      );
      animate();
    }

    const randomBetween = (min, max) => min + Math.random() * (max - min);

    function blink() {
      if (reduceMotion.matches) return;

      iris.classList.remove("blink");
      void iris.offsetWidth;
      iris.classList.add("blink");

      setTimeout(() => {
        iris.classList.remove("blink");
      }, 330);
    }

    function scheduleNextBlink() {
      const delay = randomBetween(1600, 4200);

      setTimeout(() => {
        blink();

        if (!reduceMotion.matches && Math.random() < 0.14) {
          setTimeout(blink, randomBetween(120, 210));
        }

        scheduleNextBlink();
      }, delay);
    }

    scheduleNextBlink();
  })();
</script>
