---
interface Props {
  path?: string;
}
const { path = "/" } = Astro.props;
---

<div id="camguard-companion" class="companion" aria-live="polite">
  <div id="companion-bubble" class="companion-bubble" hidden>
    <p id="companion-text"></p>
    <div class="companion-bubble-arrow"></div>
  </div>
  <img id="companion-mascot" class="companion-mascot" src="/mascot/mascot_sentry.png" alt="" />
</div>

<script define:vars={{ path }}>
  import("../scripts/companion.js").then(
    ({
      idle,
      sayPose,
      onCustomEvent,
      registerScrollTriggers,
      registerClickTriggers,
      registerHoverTriggers,
      registerHashTriggers,
    }) => {
      idle();

      // Choreografia da intro (funciona em qualquer página, mas só é visível
      // quando a intro realmente toca - ver sessionStorage em Intro.astro).
      onCustomEvent("camguard:intro-loaded", "mascot_listening");
      onCustomEvent("camguard:intro-transition", "mascot_stepping_aside");
      if (path === "/") {
        onCustomEvent(
          "camguard:intro-done",
          "mascot_waving",
          "Agente em posição. Tudo pronto para começar.",
        );
      }

      // --- Gatilhos ativos agora (elemento já existe no esqueleto) ---

      if (path === "/") {
        registerScrollTriggers([
          {
            selector: "#como-funciona",
            pose: "mascot_explaining",
            message: "Sem nuvem, sem conta. Tudo roda na sua rede.",
          },
        ]);
      }

      if (path === "/como-funciona") {
        sayPose("mascot_explaining", "Sem nuvem, sem conta. Tudo roda na sua rede.");
      }

      if (path === "/privacidade") {
        registerScrollTriggers([
          {
            selector: "#aviso-legal",
            pose: "mascot_pointing_down",
            message: "Leia com atenção — isso é sério.",
          },
        ]);
      }

      // --- Gatilhos prontos, aguardando conteúdo real da Fase 6 ---
      // Os selectors abaixo não existem ainda em nenhuma página, então os
      // registros são inertes (não encontram elemento, não disparam) até lá.

      // /baixar: hover num card de download - pose depende de o card estar
      // à esquerda ou à direita do companion (fixo no canto inferior direito).
      registerHoverTriggers([
        {
          selector: '[data-mascot-trigger="download-card"]',
          pose: (el) => {
            const rect = el.getBoundingClientRect();
            const center = rect.left + rect.width / 2;
            return center > window.innerWidth / 2 ? "mascot_pointing_right" : "mascot_pointing_left";
          },
          message: "Esse é o caminho certo.",
        },
      ]);

      // /baixar: clique em concluir/confirmar download.
      registerClickTriggers([
        {
          selector: '[data-mascot-trigger="download-confirm"]',
          pose: "mascot_celebrating",
          message: "Missão cumprida. O pacote foi entregue.",
        },
        // /baixar: interação de verificação de hash (copiar hash, expandir instruções).
        {
          selector: '[data-mascot-trigger="hash-verify"]',
          pose: "mascot_saluting",
          message: "Identidade confirmada. Acesso liberado.",
        },
      ]);

      // /sobre: itens do roadmap - pose alterna esquerda/direita por índice,
      // fala vem de data-mascot-message em cada item (fallback genérico).
      registerScrollTriggers([
        {
          selector: '[data-mascot-trigger="roadmap-item"]',
          pose: (_el, index) => (index % 2 === 0 ? "mascot_pointing_left" : "mascot_pointing_right"),
          message: (el) => el.dataset.mascotMessage || "Isso ainda está por vir.",
        },
      ]);

      registerHashTriggers({
        // roadmap: { pose: "mascot_explaining", message: "..." },
      });
    },
  );
</script>

<style>
  .companion {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 500;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: none;
  }

  .companion-mascot {
    width: 96px;
    height: auto;
  }

  .companion-bubble {
    position: relative;
    max-width: 260px;
    margin-bottom: 10px;
    padding: 12px 14px;
    background: var(--bg-card);
    border: 1px solid rgba(243, 221, 209, 0.12);
    border-radius: var(--radius-md);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    font-family: var(--font-display);
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-primary);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .companion-bubble.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .companion-bubble p {
    margin: 0;
  }

  .companion-bubble-arrow {
    position: absolute;
    bottom: -6px;
    right: 24px;
    width: 12px;
    height: 12px;
    background: var(--bg-card);
    border-right: 1px solid rgba(243, 221, 209, 0.12);
    border-bottom: 1px solid rgba(243, 221, 209, 0.12);
    transform: rotate(45deg);
  }
</style>
