---
import Layout from "../layouts/Layout.astro";
import GlowBackground from "../components/GlowBackground.astro";

const features = [
  {
    num: "01",
    title: "100% local",
    desc: "Vídeo e gravações nunca saem da sua rede. Não existe servidor nosso no meio.",
  },
  {
    num: "02",
    title: "Sem assinatura",
    desc: "É grátis. Sempre foi feito pra uso próprio, e continua disponível pra quem quiser.",
  },
  {
    num: "03",
    title: "Reaproveita o que você já tem",
    desc: "Celular velho na gaveta ou câmera IP genérica já servem.",
  },
  {
    num: "04",
    title: "Multiplataforma",
    desc: "Hub roda em Windows ou Linux. Câmeras conectam via app Android ou IP direto.",
  },
];
---

<Layout title="Início">
  <section class="hero container">
    <GlowBackground variant="hero" />
    <div class="hero-content">
      <span class="pill"><span class="pill-dot"></span>grátis · código fechado · roda na sua rede</span>
      <h1 class="hero-title">
        Suas câmeras de segurança já estão numa <span class="text-gradient">gaveta</span>.
      </h1>
      <p class="hero-lead">
        CamGuard Hub transforma celulares antigos e câmeras IP baratas num
        sistema de monitoramento residencial. Sem nuvem, sem conta, sem
        mensalidade: tudo roda dentro da sua própria casa.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/baixar">Baixar grátis</a>
        <a class="btn btn-secondary" href="/como-funciona">Ver tutoriais e documentação</a>
      </div>
    </div>
  </section>

  <section class="page-shell container">
    <!-- Espaço reservado para uma screenshot REAL do painel do Hub (Fase 6
         de conteúdo, ainda não capturada) — não é um mockup decorativo de
         janela de browser/terminal, é o lugar exato onde a imagem real
         entra depois. -->
    <div class="mock-window reveal">
      <div class="mock-window__bar">
        <span class="mock-window__label">Screenshot real do Hub, ainda não capturada</span>
      </div>
      <div class="mock-window__body">
        <span>Aqui entra uma captura de tela real do painel do Hub (Fase 6 de conteúdo).</span>
      </div>
    </div>
  </section>

  <section class="page-shell container">
    <ul class="feature-list reveal">
      {
        features.map((f) => (
          <li class="feature-item">
            <span class="feature-num text-gradient">{f.num}</span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    /* Sem overflow:hidden: o glow (GlowBackground) precisa sangrar pra fora
       da section. html/body já cortam qualquer overflow horizontal (ver
       global.css); overflow vertical aqui é só o glow desbotando, esperado.
       Padding só vertical — a largura/centralização agora vem do .container
       (aplicado junto na section, junto com .hero). */
    padding-block: clamp(56px, 12vw, 100px);
  }

  .hero > :global(*):not(.glow-bg) {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    /* Medida de leitura mais estreita que o container (1100px), mas
       alinhada à mesma borda esquerda dele — não recentraliza sozinha. */
    max-width: 700px;
  }

  .hero-title {
    /* Fluida entre o piso de 300px e o teto de 700px da própria coluna
       (.hero-content) — acima disso o box já está limitado, então o
       tamanho máximo não precisa crescer mais. */
    font-size: clamp(28px, 9vw, 56px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 24px 0;
  }

  .hero-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 0 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .mock-window {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(243, 221, 209, 0.1);
  }

  .mock-window__bar {
    background: var(--bg-titlebar);
    padding: 10px 16px;
    display: flex;
    align-items: center;
  }

  .mock-window__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .mock-window__body {
    background: repeating-linear-gradient(
      135deg,
      var(--bg-input),
      var(--bg-input) 12px,
      var(--bg-card) 12px,
      var(--bg-card) 24px
    );
    aspect-ratio: 16 / 8;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
  }

  .mock-window__body span {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  /* Em telas muito estreitas, 16:8 fica baixo demais pro texto do placeholder
     quebrar em várias linhas sem cortar — troca por altura mínima. */
  @media (max-width: 479px) {
    .mock-window__body {
      aspect-ratio: auto;
      min-height: 160px;
    }
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 800px;
  }

  .feature-item {
    display: flex;
    gap: 24px;
    align-items: baseline;
    padding: 22px 8px;
    border-bottom: 1px solid rgba(243, 221, 209, 0.08);
  }

  .feature-num {
    flex: none;
    width: 52px;
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 600;
  }

  .feature-item h3 {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .feature-item p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-tertiary);
    margin: 0;
  }

  @media (max-width: 379px) {
    .feature-item {
      gap: 14px;
    }

    .feature-num {
      width: 36px;
      font-size: 20px;
    }
  }
</style>
